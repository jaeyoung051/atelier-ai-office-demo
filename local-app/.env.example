# 이 파일을 .env로 복사한 뒤 PC에서만 편집하세요. 실제 키를 공유하지 마세요.
ANTHROPIC_API_KEY=
# Claude Console에서 사용 가능한 모델 ID 입력
PIXFFICE_CLAUDE_MODEL=
PIXFFICE_PORT=4313

GEMINI_API_KEY=
PIXFFICE_PROVIDER=Gemini
PIXFFICE_GEMINI_MODEL=gemini-3.5-flash-lite

# 노션 일정 읽기 연동 (키는 이 PC의 .env에만 입력)
NOTION_TOKEN=
NOTION_CALENDAR_DATA_SOURCE_ID=
NOTION_CALENDAR_DATE_PROPERTY=날짜
NOTION_CALENDAR_TYPE_PROPERTY=일정유형
NOTION_CALENDAR_PROJECT_PROPERTY=현장
