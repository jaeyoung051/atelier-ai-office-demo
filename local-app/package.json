{
  "name": "pixffice-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "db:init": "node --experimental-strip-types backend/cli.ts init",
    "db:backup": "node --experimental-strip-types backend/cli.ts backup",
    "start": "node --env-file-if-exists=.env --experimental-strip-types backend/server.ts",
    "test": "node --experimental-strip-types --test backend/test/*.test.ts",
    "backup:full": "node --env-file-if-exists=.env --experimental-strip-types backend/backup-cli.ts backup",
    "restore:full": "node --env-file-if-exists=.env --experimental-strip-types backend/backup-cli.ts restore",
    "app:start": "node --env-file-if-exists=.env --experimental-strip-types tools/manage.ts start",
    "app:stop": "node --experimental-strip-types tools/manage.ts stop"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "image-size": "2.0.3"
  }
}
